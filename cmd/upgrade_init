#!/bin/bash
# ============================================================================
#  upgrade_init —— 升级前执行
# ============================================================================
#  停掉旧版本进程，让文件替换不撞占用。
#  并主动作废旧 launch token（升级策略：旧令牌一律失效）。
#  用户不会察觉 —— 网关下次点开时用新令牌自动完成无感登录。
#  用 `bash main` 而非 `./main`：fpk 内脚本无执行位。
# ============================================================================

set -u

if [ -f "${TRIM_APPDEST}/cmd/main" ]; then
    bash "${TRIM_APPDEST}/cmd/main" stop >/dev/null 2>&1 || true
fi

# ── 作废旧 launch token ─────────────────────────────────────────────────────
# 升级后旧令牌必须失效，避免旧链接/旧分享地址继续有效。
# 删掉文件即可：install_callback 会在升级流程里重新生成一个新的。
if [ -n "${TRIM_PKGVAR:-}" ]; then
    rm -f "${TRIM_PKGVAR}/launch-token.env" 2>/dev/null || true
    # 旧版本用的内部端口是 ±10000 推导值，清掉避免误读。
    rm -f "${TRIM_PKGVAR}/internal.port" 2>/dev/null || true
fi

exit 0
