#!/bin/bash
# ============================================================================
#  uninstall_init —— 卸载前执行
# ============================================================================
#  先停服务，避免卸载时进程仍占用文件与 socket。
#  不删除用户数据：profile、会话记录、工作区都留在 home 与 var 目录，
#  由 fnOS 根据用户在向导里的选择决定是否清理。
#
#  用 `bash main` 而不是 `./main`：fpk 内的脚本权限是 644，没有可执行位，
#  直接执行会 Permission denied。
# ============================================================================

set -u

if [ -f "${TRIM_APPDEST}/cmd/main" ]; then
    bash "${TRIM_APPDEST}/cmd/main" stop >/dev/null 2>&1 || true
fi

exit 0
