#!/bin/bash
# ============================================================================
#  install_init —— 应用文件落盘前执行
# ============================================================================
#  只做前置检查，不修改系统。任何不满足的条件都以清晰文案返回失败，
#  fnOS 会把这些文案展示给用户。
# ============================================================================

set -u

# 确认 CPU 架构与包声明一致（本包只出 x86_64）。
ARCH=$(uname -m)
case "${ARCH}" in
    x86_64|amd64)
        ;;
    *)
        if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
            echo "本安装包仅支持 x86_64 设备，当前设备架构为 ${ARCH}。" >> "${TRIM_TEMP_LOGFILE}"
        fi
        exit 1
        ;;
esac

exit 0
