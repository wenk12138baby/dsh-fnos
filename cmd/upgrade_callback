#!/bin/bash
# ============================================================================
#  upgrade_callback —— 升级后执行
# ============================================================================
#  重跑安装期初始化（幂等），让新版本的默认配置与 home patch 生效，
#  同时保留用户已有数据。
#  用 `bash` 而非直接执行：fpk 内脚本无执行位。
# ============================================================================

set -u

if [ -f "${TRIM_APPDEST}/cmd/install_callback" ]; then
    bash "${TRIM_APPDEST}/cmd/install_callback" || exit 1
fi

exit 0
