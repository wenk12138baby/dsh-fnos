{
  "name": "dsh-fnos-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 的飞牛 fnOS 面板：跨设备访问链接与 DeepSeek 账号登录",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {}
}
